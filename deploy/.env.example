# ==============================================================================
# portaX Non-Secret Environment Configuration Template
# Copy to deploy/.env and adjust for your environment.
# DO NOT put passwords or secret keys in this file; all secrets are read from
# /etc/portax/secrets/* via Docker Compose secrets.
# ==============================================================================

# Public Hostnames
PORTAL_DOMAIN=panel.alsa.web.id
AUTH_DOMAIN=auth.alsa.web.id

# Cloudflare Access (Layer 1 Perimeter Verification)
# Example Team Domain: https://your-team-name.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=https://example-team.cloudflareaccess.com
# Application Audience (AUD) Tag from Cloudflare Zero Trust -> Access -> Applications
CF_ACCESS_AUD_TAG=replace_with_64_char_cloudflare_access_aud_tag

# OIDC Configuration (Layer 2 Identity via Authentik)
OIDC_ISSUER_URL=https://auth.alsa.web.id/application/o/portax/
# Internal back-channel endpoint via Caddy :8081 (bypasses Cloudflare edge for token/JWKS exchange)
OIDC_INTERNAL_BASE_URL=http://172.30.1.2:8081/application/o/portax
OIDC_CLIENT_ID=portax-confidential-client
OIDC_REDIRECT_URL=https://panel.alsa.web.id/auth/callback

# Session Lifetimes
SESSION_USER_IDLE_TIMEOUT=30m
SESSION_USER_ABSOLUTE_TIMEOUT=12h
SESSION_ADMIN_IDLE_TIMEOUT=10m
SESSION_ADMIN_ABSOLUTE_TIMEOUT=1h

# Catalog Launch URL Allowed Host Suffixes (comma-separated)
ALLOWED_LAUNCH_HOST_SUFFIXES=alsa.web.id,ts.net

# Prober Interval
PROBE_INTERVAL=30s
